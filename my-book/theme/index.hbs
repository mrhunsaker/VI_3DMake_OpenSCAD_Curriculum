<!DOCTYPE HTML>
<html lang="{{ language }}" class="{{ default_theme }} sidebar-visible">

<head>
  <meta charset="UTF-8">
  <title>{{ title }}</title>

  {{> head }}

  <link rel="stylesheet" href="{{ resource "css/variables.css" }}">
  <link rel="stylesheet" href="{{ resource "css/general.css" }}">
  <link rel="stylesheet" href="{{ resource "css/chrome.css" }}">

  <script>
    const path_to_root = "{{ path_to_root }}";
  </script>
</head>

<body>

<div id="mdbook-body-container">

  <nav id="mdbook-sidebar" class="sidebar">
    <mdbook-sidebar-scrollbox class="sidebar-scrollbox"></mdbook-sidebar-scrollbox>
  </nav>

  <div id="mdbook-page-wrapper">

    <div class="menu-bar sticky">

      <div class="left-buttons">

        <label id="mdbook-sidebar-toggle" class="icon-button">☰</label>

        <button id="mdbook-theme-toggle" class="icon-button">🎨</button>

        <ul id="mdbook-theme-list" class="theme-popup">
          <li><button class="theme" id="light">Light</button></li>
          <li><button class="theme" id="rust">Rust</button></li>
          <li><button class="theme" id="coal">Coal</button></li>
          <li><button class="theme" id="navy">Navy</button></li>
        </ul>

      </div>

      <h1 class="menu-title">{{ book_title }}</h1>
    </div>

    <div id="mdbook-content">
      <main>{{{ content }}}</main>
    </div>

  </div>
</div>

<!-- JS: correct order -->
<script src="{{ resource "clipboard.min.js" }}"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>

<link rel="stylesheet" href="{{ resource "highlight.css" }}">

<script src="{{ resource "book.js" }}"></script>

</body>
</html>