<meta name="viewport" content="width=device-width, initial-scale=1" />

<meta name="theme-color" content="#ffffff" />

<!-- mdBook runtime config -->
<script>
  window.path_to_root = "{{path_to_root}}"; window.default_theme = "{{default_theme}}";
  window.preferred_dark_theme = "{{preferred_dark_theme}}";
</script>

<!-- CSS for print/search/sidebar behavior -->
<link rel="stylesheet" href="{{resource 'css/variables.css'}}" />
<link rel="stylesheet" href="{{resource 'css/general.css'}}" />
<link rel="stylesheet" href="{{resource 'css/chrome.css'}}" />

<!-- Favicon support (optional but standard mdBook baseline) -->
{{#if favicon_svg}}
  <link rel="icon" href="{{path_to_root}}favicon.svg" />
{{/if}}

{{#if favicon_png}}
  <link rel="shortcut icon" href="{{path_to_root}}favicon.png" />
{{/if}}

<!-- mdBook built-in highlight styling -->
<link rel="stylesheet" href="{{resource 'highlight.css'}}" />